# K-VOID Programming Hub — Environment Configuration
# Copy this to .env and fill in your values.
# These variables are injected at build/deploy time via Netlify or similar.
# They replace placeholders in js/config.js.

# === APPWRITE ===
# Your Appwrite project endpoint
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1

# Your Appwrite project ID
APPWRITE_PROJECT_ID=

# === DATABASE ===
# Appwrite database ID
DATABASE_ID=main

# === STORAGE ===
# Appwrite storage bucket ID for avatars
AVATARS_BUCKET_ID=avatars

# === AI PROVIDERS ===
# At least one AI provider API key is required for VOID Assistant
# Groq (recommended — free tier available)
GROQ_API_KEY=

# Google Gemini
GEMINI_API_KEY=

# OpenRouter
OPENROUTER_API_KEY=

# OpenCode Zen
OPENCODE_ZEN_API_KEY=

# === DEPLOYMENT ===
# Base URL for email verification links
SITE_URL=https://voidcode.tech
