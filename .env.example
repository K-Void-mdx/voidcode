# Google Gemini (Free tier available)
GEMINI_API_KEY=

# OpenRouter (Supports multiple models)
OPENROUTER_API_KEY=

# OpenCode Zen (Alternative provider)
OPENCODE_ZEN_API_KEY=

# ============================================================================
# DEPLOYMENT
# ============================================================================

# Base URL for authentication callbacks and email links
SITE_URL=https://primevoidcourse.dpdns.org

# ============================================================================
# NOTES
# ============================================================================
# - NEXT_PUBLIC_* variables are exposed to frontend (safe for API keys)
# - Other variables are backend-only (keep secrets safe)
